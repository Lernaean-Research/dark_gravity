# Intermediate PDFs in the manuscript workspace
Intrinsic_Response_Sector_as_Dark_Gravity/*_new.pdf

arxiv/build/
arxiv/_build/
arxiv/scratch/

# arXiv working directories and exports
arxiv/
overleaf_export/
*_overleaf.zip
*_export.zip
*.zip

# arxiv_robust: exclude build/scratch cruft but allow the repro_package
arxiv_robust/build/
arxiv_robust/scratch/
arxiv_robust/*/build/
arxiv_robust/*/scratch/
# exclude debug/archive Python files from repro_package
arxiv_robust/**/sparc_analysis_ARCHIVE_*.py
arxiv_robust/**/sparc_analysis_repaired_attempt.py
# exclude empty/transient LaTeX artifacts
arxiv_robust/**/*.synctex\(busy\)

# --- toy_models: keep methodology + manifests, avoid huge third-party data ---
# Raw FITS / archives / compressed products are typically enormous and/or not ours.
toy_models/data/**/*.fits
toy_models/data/**/*.fit
toy_models/data/**/*.fz
toy_models/data/**/*.fits.gz
toy_models/data/**/*.fit.gz
toy_models/data/**/*.tar
toy_models/data/**/*.tar.gz
toy_models/data/**/*.tgz
toy_models/data/**/*.zip
toy_models/data/**/*.7z
toy_models/data/**/*.rar
toy_models/data/**/*.gz
toy_models/data/**/*.pdf
toy_models/data/**/*.pdf.gz

# Derived FITS can also be very large; keep derived tables/figures instead.
toy_models/out_*/**/*.fits
toy_models/out_*/**/*.fit
toy_models/out_*/**/*.fits.gz
toy_models/out_*/**/*.fit.gz

# Large generated outputs (PDFs and images) should remain local.
toy_models/out_*/**/*.pdf
toy_models/out_*/**/*.png
toy_models/out_*/**/*.jpg
toy_models/out_*/**/*.jpeg
toy_models/out_predictions/**

# Allow lightweight provenance and manifests under data/
!toy_models/data/**/*.md
!toy_models/data/**/*.txt
!toy_models/data/**/*.csv
!toy_models/data/**/*.tsv
!toy_models/data/**/*.json
!toy_models/data/**/*.yml
!toy_models/data/**/*.yaml

# Rubin notebook runtime outputs (generated per run)
rubin_rsp/out/**

# Keep canonical review docs and notebook source; drop volatile data products.
rubin_rsp/data/sparc_rubin_overlap.csv
rubin_rsp/data/sparc175_reference.csv
rubin_rsp/data/sparc_coord_cache.csv
rubin_rsp/data/sparc175_unresolved_independent.csv
rubin_rsp/out/sparc175_reference_independent_report.json

# Toy-model generated result trees (large/volatile)
toy_models/out_*/**
toy_models/out_sparc_runs_*/**

# Standalone generated CSV/output files at toy_models root
toy_models/out_*.csv

# Notebook/editor runtime metadata
**/.ipynb_checkpoints/
